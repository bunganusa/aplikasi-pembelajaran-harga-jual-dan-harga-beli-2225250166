# Default Gemini Flash-Lite (Google AI Studio free tier; batas penggunaan berlaku).
# Isi API key secara lokal. Jangan unggah .env ke GitHub.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite

# Public browser key protected by the insert-only policy in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
